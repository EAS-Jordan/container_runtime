    if err := syscall.Unshare(syscall.CLONE_NEWUTS); err != nil {
        return fmt.Errorf("failed to unshare UTS namespace: %v", err)
    }
    
    // Set the hostname
    if err := syscall.Sethostname([]byte(hostname)); err != nil {
