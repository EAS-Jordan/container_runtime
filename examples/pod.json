{
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
        "name": "sample-pod",
        "labels": {
            "app": "demo"
        }
    },
    "spec": {
        "containers": [
            {
                "name": "web",
                "image": "nginx:1.14.2",
                "ports": [
                    {
                        "containerPort": 80,
                        "protocol": "TCP"
                    }
                ],
                "resources": {
                    "limits": {
                        "memory": "128Mi",
                        "cpu": "500m"
                    },
                    "requests": {
                        "memory": "64Mi",
                        "cpu": "250m"
                    }
                },
                "volumeMounts": [
                    {
                        "name": "config-volume",
                        "mountPath": "/etc/nginx/conf.d"
                    },
                    {
                        "name": "shared-data",
                        "mountPath": "/data"
                    }
                ]
            },
            {
                "name": "logger",
                "image": "busybox:1.28",
                "command": [
                    "/bin/sh",
                    "-c",
                    "while true; do echo $(date) | tee -a /data/logs.txt; sleep 10; done"
                ],
                "resources": {
                    "limits": {
                        "memory": "64Mi",
                        "cpu": "100m"
                    },
                    "requests": {
                        "memory": "32Mi",
                        "cpu": "50m"
                    }
                },
                "volumeMounts": [
                    {
                        "name": "shared-data",
                        "mountPath": "/data"
                    }
                ]
            }
        ],
        "initContainers": [
            {
                "name": "init-config",
                "image": "busybox:1.28",
                "command": [
                    "/bin/sh",
                    "-c",
                    "echo 'server { listen 80; location / { return 200 \"Hello from Pod '\"$HOSTNAME\"'\"; } }' > /config/default.conf"
                ],
                "volumeMounts": [
                    {
                        "name": "config-volume",
                        "mountPath": "/config"
                    }
                ]
            }
        ],
        "volumes": [
            {
                "name": "config-volume",
                "emptyDir": {}
            },
            {
                "name": "shared-data",
                "emptyDir": {}
            }
        ],
        "dnsPolicy": "ClusterFirst",
        "restartPolicy": "Always",
        "securityContext": {
            "fsGroup": 1000,
            "runAsUser": 1000,
            "runAsGroup": 1000
        },
        "terminationGracePeriodSeconds": 30
    }
}